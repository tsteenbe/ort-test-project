    "directory": "test-project/website"
  },
  "license": "BSD-2-Clause",
  "author": "Dev C <dev.c@example.org> (https://example.org)",
  "contributors": [
    "Dev D <dev.d@example.org>"
  ],
  "private": true,
  "type": "commonjs",
  "main": "build.js",
  "files": [
    "build.js",
    "src"
  ],
  "engines": {
