    "static-site",
    "mock",
    "ort"
  ],
  "homepage": "https://github.com/tsteenbe/ort-test-project/tree/main/test-project/website",
  "bugs": {
    "url": "https://github.com/tsteenbe/ort-test-project/issues"
  },
  "repository": {
